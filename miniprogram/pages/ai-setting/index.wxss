.intro{display:flex;align-items:center}.spark{width:76rpx;height:76rpx;line-height:76rpx;text-align:center;background:#5e63a7;color:#fff;border-radius:23rpx;font-size:34rpx;margin-right:18rpx}.intro>view:last-child>view{font-size:37rpx;font-weight:800}.intro text{display:block;font-size:22rpx;color:var(--muted);margin-top:7rpx}.options{padding:0 27rpx}.option{height:86rpx;display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid var(--line)}.option:last-child{border:0}.radio{width:28rpx;height:28rpx;border:3rpx solid #c6cbc8;border-radius:50%}.radio.active{border:8rpx solid var(--green);width:18rpx;height:18rpx}.chips{display:flex;gap:12rpx;flex-wrap:wrap}.chip{background:#fff;border:2rpx solid transparent;border-radius:18rpx;padding:17rpx 27rpx;color:#66706b;font-size:25rpx}.chip.active{background:#e2efe9;border-color:#9bc0b2;color:var(--green)}.small-area{width:100%;height:105rpx;font-size:27rpx}.save{margin-top:32rpx;line-height:90rpx}
