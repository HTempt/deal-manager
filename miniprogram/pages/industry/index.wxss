.intro view{font-size:43rpx;font-weight:800}.intro text{display:block;color:var(--muted);font-size:24rpx;margin-top:10rpx}.industry-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:32rpx;padding-bottom:130rpx}.industry{position:relative;background:#fff;border-radius:24rpx;padding:24rpx;display:flex;align-items:center;border:2rpx solid transparent}.industry.active{border-color:var(--green);background:#eef6f2}.industry-icon{width:62rpx;height:62rpx;border-radius:19rpx;background:#edf0eb;line-height:62rpx;text-align:center;color:#66716c;font-weight:700;margin-right:15rpx}.industry.active .industry-icon{background:var(--green);color:#fff}.industry>text{font-weight:650}.check{position:absolute;right:18rpx;color:var(--green);font-weight:800}.fixed-action{line-height:90rpx}
