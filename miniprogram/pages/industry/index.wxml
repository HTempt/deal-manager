<view class="page industry-page"><view class="intro"><view>选择你的行业</view><text>行业会影响客户阶段和 AI 话术建议</text></view><view class="industry-grid"><view wx:for="{{options}}" wx:key="industryCode" class="industry {{current===item.industryName?'active':''}}" data-name="{{item.industryName}}" bindtap="choose"><view class="industry-icon">{{item.icon}}</view><text>{{item.industryName}}</text><view class="check">{{current===item.industryName?'✓':''}}</view></view></view><button class="primary-btn fixed-action" loading="{{saving}}" bindtap="save">保存设置</button></view>
