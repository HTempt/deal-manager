<view class="page mine-page">
  <view class="page-heading">我的</view>
  <view class="profile" wx:if="{{profile}}"><view class="avatar">{{profile.avatar}}</view><view class="identity"><view>{{profile.user.nickname || '老板'}}</view><text>{{profile.user.industry || '请选择行业'}} · {{profile.user.membershipType==='FREE'?'免费版':'专业版'}}</text></view><view class="badge">{{profile.user.membershipType==='FREE'?'FREE':'PRO'}}</view></view>
  <view class="member-card" wx:if="{{profile}}"><view class="member-top"><view><view class="member-name">跟客 <text>{{profile.user.membershipType==='FREE'?'免费版':'专业版'}}</text></view><view class="member-copy">客户来了以后，不让他被忘记</view></view><button bindtap="go" data-url="/pages/membership/index">升级会员</button></view><view class="usage"><view><view><text>客户</text><text>{{profile.customerUsage}} / {{profile.customerLimit<0?'不限':profile.customerLimit}}</text></view><progress percent="{{profile.customerLimit<0?0:profile.customerUsage/profile.customerLimit*100}}" activeColor="#e8b66f" backgroundColor="rgba(255,255,255,.13)" stroke-width="5" /></view><view><view><text>AI 今日用量</text><text>{{profile.aiLimit<0?'VIP 无限':profile.aiUsed + ' / ' + profile.aiLimit}}</text></view><progress wx:if="{{profile.aiLimit>=0}}" percent="{{profile.aiLimit ? profile.aiUsed/profile.aiLimit*100 : 0}}" activeColor="#82c9ad" backgroundColor="rgba(255,255,255,.13)" stroke-width="5" /><text wx:else class="unlimited-label">无限使用</text></view></view></view>
  <view class="group-title">功能设置</view><view class="menu card"><view class="menu-item" bindtap="go" data-url="/pages/industry/index"><view class="menu-icon green">▦</view><text>行业设置</text><text class="arrow">›</text></view><view class="menu-item" bindtap="go" data-url="/pages/ai-setting/index"><view class="menu-icon purple">✦</view><text>AI 设置</text><text class="arrow">›</text></view><view class="menu-item" bindtap="go" data-url="/pages/membership/index"><view class="menu-icon gold">♢</view><text>会员中心</text><text class="arrow">›</text></view></view>
  <view class="group-title">提醒设置</view>
  <view class="menu card">
    <view class="menu-item notification-row"><view class="setting-copy"><text>微信跟进提醒</text><text class="hint">{{notificationReady ? (notificationEnabled ? '已开启' : '已关闭') : '设置加载失败'}}</text></view><switch color="#176B52" checked="{{notificationEnabled}}" disabled="{{!notificationReady || notificationSaving}}" bindchange="toggleNotifications" /></view>
    <view class="menu-item notification-row" wx:if="{{notificationEnabled}}"><view class="setting-copy"><text>微信订阅授权</text></view><button class="notification-subscribe" disabled="{{notificationSaving}}" loading="{{notificationSaving}}" bindtap="subscribeNotifications">订阅提醒</button></view>
  </view>
  <view class="group-title">其他</view><view class="menu card"><view class="menu-item" bindtap="about"><view class="menu-icon gray">i</view><text>关于我们</text><text class="arrow">›</text></view></view>
</view>
