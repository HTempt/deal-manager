.unlimited-label{display:block;color:#82c9ad;font-size:22rpx}.page-heading{font-size:48rpx;font-weight:800;line-height:1.25;margin-bottom:24rpx}.profile{display:flex;align-items:center;padding:10rpx 4rpx 28rpx}.avatar{width:92rpx;height:92rpx;border-radius:30rpx;background:var(--green);color:#fff;text-align:center;line-height:92rpx;font-size:36rpx;font-weight:700}.identity{flex:1;margin-left:20rpx}.identity view{font-size:36rpx;font-weight:800}.identity text{font-size:23rpx;color:var(--muted);display:block;margin-top:7rpx}.badge{font-size:19rpx;letter-spacing:2rpx;border:1rpx solid #c59a55;color:#9c7134;padding:7rpx 12rpx;border-radius:8rpx}.member-card{background:linear-gradient(135deg,#23352f,#14231e);color:#fff;border-radius:32rpx;padding:28rpx;box-shadow:0 17rpx 34rpx rgba(15,35,28,.16)}.member-top{display:flex;justify-content:space-between;align-items:center}.member-name{font-size:31rpx;font-weight:750}.member-name text{font-size:18rpx;color:#e6bd7e;border:1rpx solid #806b49;border-radius:7rpx;padding:4rpx 8rpx;margin-left:8rpx}.member-copy{font-size:21rpx;opacity:.55;margin-top:8rpx}.member-top button{background:#e7bb78;color:#3b3021;font-size:22rpx;border-radius:99rpx;line-height:61rpx;padding:0 22rpx;margin:0}.member-top button::after{border:0}.usage{display:flex;gap:30rpx;margin-top:28rpx}.usage>view{flex:1}.usage>view>view{display:flex;justify-content:space-between;font-size:20rpx;color:rgba(255,255,255,.68);margin-bottom:9rpx}.group-title{font-size:23rpx;color:#858d89;margin:32rpx 8rpx 14rpx}.menu{padding:0 26rpx}.menu-item{display:flex;align-items:center;height:99rpx;border-bottom:1rpx solid var(--line)}.menu-item:last-child{border:0}.menu-icon{width:54rpx;height:54rpx;border-radius:17rpx;text-align:center;line-height:54rpx;margin-right:18rpx;font-weight:700}.green{background:#e1efe9;color:var(--green)}.purple{background:#ecebfa;color:#666bb0}.gold{background:#fff1db;color:#ae792d}.blue{background:#e5eef5;color:#4d7d9e}.gray{background:#eceeeb;color:#717975}.menu-item>text:nth-child(2){flex:1;font-size:27rpx}.hint{font-size:22rpx;color:var(--muted)}.arrow{font-size:36rpx;color:#a8aeab;margin-left:10rpx}
.notification-row{min-height:110rpx;height:auto;padding:16rpx 0;gap:16rpx}.setting-copy{flex:1;min-width:0}.setting-copy>text{display:block;font-size:27rpx;line-height:1.5}.setting-copy .hint{font-size:22rpx;color:var(--muted);margin-top:4rpx}.notification-row switch{flex-shrink:0}.notification-subscribe{flex-shrink:0;margin:0;padding:0 18rpx;font-size:24rpx;line-height:64rpx;color:var(--green);background:#e1efe9;border-radius:8rpx}.notification-subscribe::after{border:0}
