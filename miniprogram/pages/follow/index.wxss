.head{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx}.page-heading{font-size:48rpx;font-weight:800;line-height:1.25}.subtitle{font-size:24rpx;color:var(--muted);margin-top:8rpx}.total{font-size:44rpx;font-weight:800;color:var(--green);overflow-wrap:anywhere;max-width:40%}.switch{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6rpx;background:#e9ece7;border-radius:8rpx;padding:7rpx;margin-top:30rpx}.switch-item{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:94rpx;padding:8rpx 4rpx;border-radius:8rpx;color:#747d79;font-weight:600;box-sizing:border-box;min-width:0}.switch-label{font-size:26rpx;line-height:1.4}.switch-count{font-size:23rpx;line-height:1.4;overflow-wrap:anywhere;max-width:100%;margin-top:4rpx}.switch-item.active{background:#fff;color:var(--green)}.switch-item.active.danger{color:#c85c3b}.unscheduled-link{font-size:25rpx;color:var(--green);padding:20rpx 4rpx;text-align:right}.date-label{display:flex;justify-content:space-between;gap:16rpx;margin:16rpx 4rpx;color:#68716d;font-size:24rpx;line-height:1.5}.date-label text:last-child{color:var(--muted);flex-shrink:0}.task{display:flex;padding:0;overflow:hidden;margin-bottom:18rpx;border-radius:8rpx}.task-bar{width:9rpx;flex-shrink:0;background:var(--green)}.task-bar.red{background:#c85c3b}.task-content{padding:24rpx;flex:1;min-width:0}.task-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;flex-wrap:wrap}.task-identity{min-width:0;flex:1;display:flex;align-items:center;flex-wrap:wrap;gap:10rpx}.name{font-size:30rpx;font-weight:750;overflow-wrap:anywhere}.stage{font-size:20rpx;line-height:1.5;background:#edf3f0;color:var(--green);padding:4rpx 10rpx;border-radius:6rpx;overflow-wrap:anywhere}.amount{font-weight:700;font-size:26rpx;overflow-wrap:anywhere;max-width:100%;line-height:1.5}.task-title{color:#616a66;font-size:25rpx;margin-top:13rpx;line-height:1.5;overflow-wrap:anywhere}.plan-date{font-size:23rpx;color:var(--muted);margin-top:12rpx;line-height:1.5}.plan-date.overdue{color:#c85c3b}.actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:23rpx}.actions button{width:100%;min-width:0;margin:0;line-height:66rpx;font-size:25rpx;border-radius:8rpx;padding:0 8rpx}.retry{margin-top:24rpx;width:200rpx;font-size:26rpx}
