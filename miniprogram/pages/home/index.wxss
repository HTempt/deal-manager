.home-page{padding-top:0}.top-safe{height:calc(34px + env(safe-area-inset-top))}.page-heading{font-size:48rpx;font-weight:800;line-height:1.25}.summary{color:#707a75;margin-top:10rpx}.summary text{color:var(--orange);font-weight:800}.hero-card{position:relative;overflow:hidden;margin-top:34rpx;border-radius:34rpx;padding:34rpx;background:linear-gradient(135deg,#124e3e,#19765a);color:#fff;min-height:270rpx;box-shadow:0 20rpx 44rpx rgba(23,107,82,.2)}.hero-orb{position:absolute;width:260rpx;height:260rpx;border-radius:50%;right:-55rpx;top:-95rpx;background:rgba(255,255,255,.08);border:1rpx solid rgba(255,255,255,.12)}.hero-title{font-size:25rpx;opacity:.72}.hero-number{font-family:"DIN Alternate";font-size:100rpx;line-height:1;font-weight:800;margin-top:20rpx}.hero-unit{position:absolute;left:135rpx;top:124rpx;font-size:25rpx;opacity:.75}.hero-empty-title{font-size:40rpx;line-height:1.25;font-weight:800;margin-top:48rpx;max-width:470rpx}.hero-empty-copy{font-size:24rpx;line-height:1.5;opacity:.72;margin-top:14rpx;max-width:450rpx}.hero-button{position:absolute;right:28rpx;bottom:30rpx;background:#fff;color:var(--green-dark);font-size:25rpx;border-radius:99rpx;line-height:70rpx;padding:0 27rpx}.hero-button::after{border:0}.metric-row{display:flex;gap:20rpx;margin-top:20rpx}.metric{flex:1;display:flex;align-items:center;padding:24rpx}.metric-icon{width:66rpx;height:66rpx;border-radius:21rpx;text-align:center;line-height:66rpx;font-size:34rpx;font-weight:800;margin-right:18rpx}.fire{background:#fff0e9;color:#df6b3e}.clock{background:#fff5d9;color:#b77b18}.metric-num,.metric-label{display:block}.metric-num{font-size:39rpx;font-weight:800;line-height:1}.metric-label{font-size:23rpx;color:var(--muted);margin-top:8rpx}.section-head{display:flex;align-items:center;justify-content:space-between}.all{color:var(--green);font-size:25rpx}.task-card{margin-bottom:18rpx}.task-top{display:flex;align-items:center}.avatar{width:76rpx;height:76rpx;border-radius:24rpx;background:#e3efe9;color:var(--green);font-size:31rpx;font-weight:700;text-align:center;line-height:76rpx;margin-right:20rpx}.task-main{flex:1}.name{font-size:31rpx;font-weight:700}.intent{font-size:20rpx;color:#d25c34;background:#fff0e9;padding:5rpx 12rpx;border-radius:99rpx;margin-left:12rpx}.desc{font-size:24rpx;color:var(--muted);margin-top:9rpx}.amount{font-weight:700;font-family:"DIN Alternate"}.task-actions{display:flex;gap:18rpx;border-top:1rpx solid var(--line);margin-top:24rpx;padding-top:20rpx}.mini{flex:1;line-height:66rpx;font-size:25rpx}.empty-sub{font-size:24rpx;margin-top:12rpx}.sk1{width:45%;height:30rpx}.sk2{width:75%;height:24rpx;margin-top:24rpx}
.metric-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.metric{min-width:0;padding:20rpx;border-radius:8rpx}.metric-icon{flex-shrink:0;width:54rpx;height:54rpx;line-height:54rpx;border-radius:8rpx;margin-right:14rpx;font-size:28rpx}.metric>view:last-child{min-width:0}.metric-num{font-size:34rpx;overflow-wrap:anywhere}.metric-label{font-size:23rpx;line-height:1.4}.overdue-icon{background:#fde8e8;color:#c74c4c}.today-icon{background:#fff0e5;color:#cc6b2d}.unscheduled-icon{background:#faf3d9;color:#957719}.high-icon{background:#e4f2e9;color:#176B52}.hero-card{display:flex;flex-direction:column;align-items:flex-start;box-sizing:border-box}.hero-unit{position:static;margin-top:10rpx}.hero-button{position:static;margin:24rpx 0 0;max-width:100%;box-sizing:border-box}.hero-empty-title{margin-top:28rpx;font-size:36rpx;max-width:100%;line-height:1.4}.hero-empty-copy{max-width:100%}
.dormant-entry{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:20rpx;padding:24rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);font-size:26rpx;line-height:1.5;color:var(--ink)}.dormant-count{font-size:30rpx;font-weight:700;color:#a46b20}
.priority-hint{font-size:23rpx;line-height:1.5;color:var(--muted);margin:-8rpx 0 22rpx}.priority-reason{margin-top:22rpx;padding:18rpx 20rpx;border-radius:12rpx;background:#edf5ef;color:#235b46;font-size:25rpx;line-height:1.7;overflow-wrap:anywhere}.reason-label{display:block;color:#638471;font-size:21rpx;margin-bottom:4rpx}.task-main{min-width:0}.name-line{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx}.name{overflow-wrap:anywhere}.amount{flex-shrink:0;margin-left:12rpx;max-width:210rpx;overflow-wrap:anywhere;text-align:right;font-size:27rpx}.avatar{flex-shrink:0}.retry-btn{margin-top:20rpx;font-size:25rpx}
.advice-overview{margin-bottom:18rpx;background:linear-gradient(135deg,#f1f8f3,#fff);border:1rpx solid #d9ebe1}.advice-overview-title{font-size:26rpx;font-weight:800;color:var(--green-dark)}.advice-count{font-size:23rpx;font-weight:500;color:var(--muted)}.advice-overview-text{margin-top:12rpx;font-size:25rpx;line-height:1.7;color:var(--ink);overflow-wrap:anywhere}.advice-meta{margin-top:14rpx;display:flex;flex-wrap:wrap;gap:12rpx;font-size:21rpx;color:var(--muted)}.advice-stale{color:#a46b20}.priority-badge{flex-shrink:0;width:60rpx;height:60rpx;line-height:60rpx;border-radius:20rpx;margin-right:18rpx;text-align:center;font-size:30rpx;font-weight:800;color:#fff}.priority-s{background:#c0392b}.priority-a{background:#d98324}.priority-b{background:#6b8e7b}.advice-text{margin-top:20rpx;padding:18rpx 20rpx;border-radius:12rpx;background:#edf5ef;color:#235b46;font-size:25rpx;line-height:1.7;overflow-wrap:anywhere}
