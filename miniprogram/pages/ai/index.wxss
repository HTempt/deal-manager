.ai-head{display:flex;align-items:center;gap:18rpx}.spark{width:64rpx;height:64rpx;flex-shrink:0;border-radius:8rpx;background:#e4f0e9;color:var(--green);text-align:center;line-height:64rpx;font-size:34rpx}.ai-title{font-size:36rpx;font-weight:800;line-height:1.4}.context{margin-top:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.context-name{font-size:30rpx;font-weight:700;line-height:1.5;overflow-wrap:anywhere}.context-name text{font-size:22rpx;color:var(--green);margin-left:12rpx}.context-row{display:grid;grid-template-columns:120rpx minmax(0,1fr);gap:16rpx;font-size:25rpx;line-height:1.6;margin-top:12rpx}.context-row text:first-child{color:var(--muted)}.context-row text:last-child{overflow-wrap:anywhere;white-space:pre-wrap}.scenario-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.scenario{box-sizing:border-box;border-radius:8rpx;padding:18rpx 14rpx;border:2rpx solid #e0e6e2;font-size:25rpx;line-height:1.5;background:#fff}.scenario.active{border-color:var(--green);background:#e7f2ed;color:var(--green);font-weight:600}.generate{margin-top:28rpx;line-height:86rpx;border-radius:8rpx;font-size:28rpx}.result{margin-top:32rpx}.result-label{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12rpx;color:var(--muted);font-size:23rpx;line-height:1.5}.result-label text:first-child{font-size:28rpx;font-weight:700;color:var(--ink)}.advice-section{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.advice-label{font-size:26rpx;font-weight:700;color:var(--ink);margin-bottom:12rpx}.advice-text{display:block;font-size:27rpx;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;color:#424d47}.script{border-left:4rpx solid var(--green);padding-left:18rpx}.result-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:22rpx}.result-actions button{width:100%;min-width:0;margin:0;padding:0 6rpx;font-size:24rpx;line-height:68rpx;border-radius:8rpx}.follow-interval{font-size:26rpx;line-height:1.6;margin-bottom:12rpx;color:var(--green);font-weight:600}.adopt{width:100%;margin-top:20rpx;line-height:78rpx;font-size:26rpx;border-radius:8rpx}.notice{font-size:22rpx;color:var(--muted);line-height:1.6;margin-top:28rpx}
.generation-error{margin-top:20rpx;font-size:24rpx;line-height:1.6;color:#b85b40;overflow-wrap:anywhere}
