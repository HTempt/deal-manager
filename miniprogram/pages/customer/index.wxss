.title-row{display:flex;justify-content:space-between;align-items:center}.page-heading{font-size:48rpx;font-weight:800;line-height:1.25}.title{font-size:48rpx;font-weight:800}.subtitle{font-size:24rpx;color:var(--muted);margin-top:9rpx}.add{width:78rpx;height:78rpx;border-radius:26rpx;background:var(--green);color:white;text-align:center;line-height:74rpx;font-size:46rpx;box-shadow:0 10rpx 26rpx rgba(23,107,82,.2)}.search{height:88rpx;border-radius:24rpx;background:#fff;display:flex;align-items:center;padding:0 24rpx;margin-top:32rpx}.search text{font-size:42rpx;color:#7e8984;margin-right:14rpx}.search input{flex:1;font-size:27rpx}.tabs{display:block;height:88rpx;white-space:nowrap;margin:26rpx -28rpx 20rpx;width:calc(100% + 56rpx);box-sizing:border-box}.tabs-inner{display:flex;width:max-content;padding:14rpx 28rpx 0;gap:22rpx;box-sizing:border-box}.tab{position:relative;display:inline-flex;align-items:center;flex:none;white-space:nowrap;padding:15rpx 25rpx;border-radius:99rpx;background:#e9ece7;color:#68716d;font-size:25rpx}.tab-count{position:absolute;top:-4rpx;right:-8rpx;min-width:28rpx;height:28rpx;line-height:28rpx;padding:0 6rpx;border:3rpx solid #f6f7f2;border-radius:99rpx;background:#ed7a45;text-align:center;font-size:18rpx;font-weight:700;color:#fff;box-sizing:content-box}.tab.active{background:var(--ink);color:#fff}.tab.active .tab-count{background:#ed7a45;color:#fff}.customer-card{display:flex;align-items:center;margin-bottom:16rpx;padding:24rpx}.avatar{width:82rpx;height:82rpx;border-radius:24rpx;background:#e4ece8;color:#527165;text-align:center;line-height:82rpx;font-weight:700;font-size:31rpx}.avatar.hot{background:#fff0e8;color:#d66337}.customer-main{flex:1;margin-left:20rpx;min-width:0}.customer-name{font-size:30rpx;font-weight:700}.customer-name text{font-size:19rpx;color:#d66337;background:#fff0e8;border-radius:99rpx;padding:5rpx 10rpx;margin-left:8rpx}.need{color:#626c67;font-size:25rpx;margin-top:7rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;gap:9rpx;color:#8b938f;font-size:22rpx;margin-top:10rpx}.meta .money{color:#424a47}.chevron{font-size:38rpx;color:#aeb4b1;margin-left:12rpx}.empty-btn{margin-top:30rpx;width:280rpx}.sk{width:55%;height:30rpx;margin-left:100rpx}.sk.small{width:70%;height:22rpx;margin-top:18rpx}
.customer-card{display:block}.customer-body{display:flex;align-items:center}.meta{flex-wrap:wrap;line-height:1.5}.customer-name{overflow-wrap:anywhere}.customer-tags{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:10rpx}.tag-pill{display:inline-block;background:#e7f2ed;color:var(--green);border-radius:99rpx;padding:5rpx 12rpx;font-size:20rpx;line-height:1.4}.unscheduled-note{font-size:25rpx;line-height:1.6;color:#8b711a;margin:0 0 20rpx}.unscheduled-label{color:#8b711a;font-weight:600}.schedule-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;border-top:1rpx solid var(--line);margin-top:20rpx;padding-top:18rpx}.schedule-actions button{width:100%;min-width:0;margin:0;padding:0 6rpx;font-size:24rpx;line-height:66rpx;border-radius:8rpx}.schedule-mask{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;padding:28rpx;box-sizing:border-box}.schedule-sheet{box-sizing:border-box;width:100%;max-width:650rpx;border-radius:8rpx;background:#fff;padding:28rpx}.schedule-title{font-size:32rpx;font-weight:700}.schedule-name{font-size:26rpx;color:var(--muted);line-height:1.5;margin-top:10rpx;overflow-wrap:anywhere}.schedule-fields{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:16rpx;margin:28rpx 0}.schedule-fields picker{background:#f1f4f1;border-radius:8rpx;text-align:center;padding:24rpx 8rpx;font-size:28rpx}.schedule-footer{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.schedule-footer button{width:100%;margin:0;line-height:76rpx;font-size:26rpx;border-radius:8rpx}
.dormancy-filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-bottom:1rpx solid var(--line);gap:8rpx;margin-bottom:20rpx}.dormancy-filter{min-width:0;text-align:center;font-size:23rpx;line-height:1.5;padding:18rpx 4rpx;color:var(--muted);border-bottom:4rpx solid transparent}.dormancy-filter.selected{color:var(--green);border-bottom-color:var(--green);font-weight:700}.dormancy-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid var(--line)}.dormancy-row>view{min-width:0}.dormancy-label{font-size:23rpx;color:#a46b20;line-height:1.5}.dormancy-label.LONG_DORMANT{color:#b34e51}.dormancy-label.AT_RISK{color:#6e761f}.inactivity{font-size:24rpx;color:var(--muted);line-height:1.5;margin-top:6rpx;overflow-wrap:anywhere}.wake-btn{flex-shrink:0;margin:0;padding:0 20rpx;font-size:24rpx;line-height:64rpx;border-radius:8rpx}.more-customers{text-align:center;color:var(--muted);font-size:24rpx;line-height:1.5;margin:24rpx 0}.more-customers button{font-size:24rpx;line-height:70rpx;margin-top:12rpx;border-radius:8rpx}
