.follow-edit{padding-bottom:50rpx}.customer-strip{display:flex;align-items:center;background:#e7f0ec;border-radius:25rpx;padding:22rpx}.avatar{width:72rpx;height:72rpx;border-radius:22rpx;background:var(--green);color:#fff;line-height:72rpx;text-align:center;font-weight:700;margin-right:18rpx}.name{font-size:30rpx;font-weight:700}.muted{font-size:22rpx;margin-top:6rpx;max-width:540rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.block-title{font-size:27rpx;font-weight:700;margin:34rpx 0 17rpx}.choice-row{display:flex;gap:13rpx}.choice-row.wrap{flex-wrap:wrap}.choice{padding:17rpx 28rpx;border-radius:18rpx;background:#fff;color:#68716d;font-size:25rpx;border:2rpx solid transparent}.choice.active{background:#e0eee8;color:var(--green);border-color:#8fb9aa}.feedback{padding:22rpx}.feedback textarea{width:100%;height:180rpx;line-height:1.6}.counter{text-align:right;color:#a0a7a3;font-size:20rpx}.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13rpx}.next{background:#fff;border-radius:18rpx;text-align:center;padding:20rpx 5rpx;color:#68716d;font-size:24rpx}.next.active{background:var(--green);color:#fff}.date-custom{display:flex;gap:16rpx;margin-top:15rpx}.date-custom picker{flex:1;background:#fff;border-radius:17rpx;padding:20rpx;text-align:center}.save{margin-top:44rpx;line-height:92rpx}
.intention-signals{display:flex;flex-wrap:wrap;gap:24rpx;margin-top:22rpx}.intention-signals label{display:flex;align-items:center;font-size:26rpx;gap:8rpx}.score-controls{padding:20rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.current-score,.manual-score-row{display:flex;justify-content:space-between;align-items:center;min-height:68rpx;font-size:26rpx}.current-score text:last-child{font-weight:700;font-size:32rpx}.score-input-row{display:flex;align-items:center;gap:16rpx;margin-top:12rpx}.score-input-row input{box-sizing:border-box;width:120rpx;height:68rpx;text-align:center;border:1rpx solid #d8dfda;border-radius:8rpx;background:#fff;font-size:30rpx;font-weight:700}.score-input-row text,.score-auto-label{font-size:24rpx;color:var(--muted)}.score-auto-label{margin-top:12rpx}
