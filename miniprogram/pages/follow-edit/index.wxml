<view class="page follow-edit">
  <view class="customer-strip" wx:if="{{customer}}"><view class="avatar">{{customer.avatar}}</view><view><view class="name">{{customer.name}}</view><view class="muted">{{customer.stage}} · {{customer.need}}</view></view></view>
  <view class="block-title">跟进方式</view><view class="choice-row"><view wx:for="{{types}}" wx:key="*this" class="choice {{type===item?'active':''}}" data-value="{{item}}" bindtap="chooseType">{{item}}</view></view>
  <view class="block-title required">客户反馈</view><view class="feedback card"><textarea placeholder="记录客户的真实反馈、疑问和下一步意向…" value="{{content}}" bindinput="content" maxlength="500"/><view class="counter">{{content.length}} / 500</view></view>
  <view class="block-title">反馈状态</view><view class="choice-row wrap"><view wx:for="{{statuses}}" wx:key="*this" class="choice {{status===item?'active':''}}" data-value="{{item}}" bindtap="chooseStatus">{{item}}</view></view>
  <checkbox-group class="intention-signals" bindchange="signals" wx:if="{{status!=='没有回应'&&status!=='已流失'}}"><label><checkbox value="activeInquiry" checked="{{activeInquiry}}" color="#176B52" />主动咨询</label><label><checkbox value="priceInquiry" checked="{{priceInquiry}}" color="#176B52" />询问价格</label></checkbox-group>
  <view class="block-title">意向评分</view><view class="score-controls"><view class="current-score"><text>当前意向分</text><text>{{customer.intentionScore}}</text></view><view class="manual-score-row"><text>人工评分</text><switch checked="{{manualScore}}" color="#176B52" bindchange="manualScore" /></view><view class="score-input-row" wx:if="{{manualScore}}"><input type="number" maxlength="3" value="{{intentionScore}}" bindinput="scoreInput" /><text>/ 100</text></view><view class="score-auto-label" wx:else>综合评分</view></view>
  <view class="block-title">下次跟进</view><view class="next-grid"><view wx:for="{{nextOptions}}" wx:key="d" class="next {{nextDays===item.d?'active':''}}" data-days="{{item.d}}" bindtap="chooseNext">{{item.n}}</view><view class="next {{custom?'active':''}}" bindtap="custom">自定义</view></view>
  <view class="date-custom" wx:if="{{custom}}"><picker mode="date" value="{{date}}" bindchange="date"><view>{{date}}</view></picker><picker mode="time" value="{{time}}" bindchange="time"><view>{{time}}</view></picker></view>
  <button class="primary-btn save" loading="{{saving}}" bindtap="submit">保存跟进</button>
</view>
