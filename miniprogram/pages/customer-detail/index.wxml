<view class="page detail-page" wx:if="{{customer}}">
  <view wx:if="{{loadError}}" class="summary-error"><text>{{loadError}}</text><button class="ghost-btn summary-retry" bindtap="retryLoad" disabled="{{loading||summaryLoading}}">重试</button></view>
  <view class="profile-card">
    <view class="profile-top"><view class="big-avatar">{{customer.avatar}}</view><view class="profile-main"><view class="profile-name">{{customer.name}}</view><view class="profile-need">{{customer.need}}</view></view><view class="edit" bindtap="edit">编辑</view></view>
    <view class="deal-line"><view><text class="label">预计金额</text><text class="big-money">¥{{customer.budgetText}}</text></view><view class="score"><text>{{customer.intentionScore}}</text><text>意向分</text></view></view>
    <view class="chips"><text class="tag">{{customer.stage}}</text><text class="tag warm">{{customer.intentText}}</text><text class="status" wx:if="{{customer.status==='DEAL'}}">已成交</text></view>
    <view class="customer-tags detail-tags" wx:if="{{customer.tags&&customer.tags.length}}"><text class="tag-pill" wx:for="{{customer.tags}}" wx:key="*this">{{item}}</text></view>
  </view>
  <view class="customer-summary">
    <view class="summary-heading"><view class="summary-title">AI 客户摘要</view><button class="ghost-btn summary-update" bindtap="refreshSummary" loading="{{summaryLoading}}" disabled="{{summaryLoading||loading}}">{{summaryLoading?'正在更新…':'更新客户摘要'}}</button></view>
    <view class="summary-notice" wx:if="{{summaryNotice}}">{{summaryNotice}}</view>
    <view class="summary-stale" wx:if="{{summary.stale}}">摘要待更新</view>
    <view class="summary-meta" wx:if="{{summary.aiGenerated&&summary.recordsUsed===0}}">基于客户资料分析</view>
    <block wx:if="{{summary}}">
      <view class="summary-label">客户概况</view><text class="summary-content">{{summary.overview}}</text>
    </block>
    <view class="summary-facts">已跟进 {{records.length}} 次 · {{hasContactHistory?'最近 '+contactDays+' 天未联系':'尚未跟进，创建已 '+contactDays+' 天'}}</view>
    <block wx:if="{{summary}}"><view class="summary-label">当前建议</view><text class="summary-content suggestion">{{summary.suggestion}}</text></block>
    <view class="summary-meta" wx:if="{{summaryUpdatedAt}}">分析时间：{{summaryUpdatedAt}}</view>
    <view class="summary-meta" wx:if="{{summary&&summary.recordsUsed<records.length}}">生成时参考 {{summary.recordsUsed}} 条最近跟进记录</view>
    <view class="summary-meta" wx:if="{{summaryLoading}}">{{loading?'正在读取最新客户资料和跟进记录…':'正在分析客户资料…'}}</view>
    <view wx:if="{{summaryError}}" class="summary-error"><text>{{summaryError}}</text><button class="ghost-btn summary-retry" bindtap="retrySummary" disabled="{{loading||summaryLoading}}">重试</button></view>
  </view>
  <view class="quick-row"><button class="quick" bindtap="call"><text>☎</text>打电话</button><button class="quick ai" bindtap="ai"><text>✦</text>AI跟进助手</button><button class="quick follow" bindtap="record"><text>＋</text>记跟进</button></view>
  <view class="section-title">客户信息</view>
  <view class="card info-card"><view class="info-row"><text>手机</text><text bindtap="call">{{customer.phoneText}} ›</text></view><view class="info-row"><text>客户所在城市</text><text>{{customer.city || '未填写'}}</text></view><view class="info-row" wx:if="{{customer.address}}"><text>详细地址</text><text>{{customer.address}}</text></view><view class="info-row"><text>来源</text><text>{{customer.source || '未填写'}}</text></view><view class="info-row"><text>下次跟进</text><text class="green">{{customer.nextText}}</text></view><view class="info-row need-row"><text>详细需求</text><text>{{customer.need}}</text></view></view>
  <view class="section-head"><view class="section-title">跟进记录</view><view class="count">{{records.length}} 次</view></view>
  <view wx:if="{{records.length}}" class="timeline"><view class="record" wx:for="{{records}}" wx:key="id"><view class="dot"></view><view class="record-card card"><view class="record-head"><text>{{item.followType || '跟进'}}</text><text>{{item.createdText}}</text></view><view class="record-content">{{item.content || '未填写反馈'}}</view><view class="record-score" wx:if="{{item.intentionBefore!=null&&item.intentionAfter!=null}}">意向：{{item.intentionBefore}} → {{item.intentionAfter}} · {{item.intentionMode==='MANUAL'?'人工评分':'综合评分'}}</view><view class="record-signals" wx:if="{{item.activeInquiry||item.priceInquiry}}"><text wx:if="{{item.activeInquiry}}">主动咨询</text><text wx:if="{{item.priceInquiry}}">询问价格</text></view><view class="next" wx:if="{{item.nextFollowTime}}">下次：{{item.nextText}}</view></view></view></view>
  <view wx:else class="empty card">还没有跟进记录</view>
  <button wx:if="{{customer.status!=='DEAL'}}" class="primary-btn deal-btn" bindtap="showDeal">标记为已成交</button>
  <button class="delete" bindtap="remove">删除客户</button>
</view>
<view class="loading" wx:else><block wx:if="{{loadError}}"><view>{{loadError}}</view><button class="ghost-btn" bindtap="retryLoad">重试</button></block><block wx:else>正在加载…</block></view>
<view class="mask" wx:if="{{dealVisible}}" catchtap="closeDeal"><view class="deal-sheet" catchtap="noop"><view class="sheet-title">确认成交</view><view class="field"><text class="field-label required">成交金额</text><input class="input" type="digit" value="{{deal.amount}}" data-key="amount" bindinput="dealInput" /></view><view class="field"><text class="field-label">产品 / 服务</text><input class="input" placeholder="例如：全屋装修" value="{{deal.productName}}" data-key="productName" bindinput="dealInput" /></view><picker mode="date" value="{{deal.dealDate}}" bindchange="dealDate"><view class="field"><text class="field-label">成交日期</text><view>{{deal.dealDate}}</view></view></picker><button class="primary-btn confirm" bindtap="confirmDeal">确认成交</button></view></view>
