.profile-card{background:linear-gradient(145deg,#fff,#f0f5f1);border-radius:32rpx;padding:30rpx}.profile-top{display:flex;align-items:center}.big-avatar{width:92rpx;height:92rpx;line-height:92rpx;text-align:center;border-radius:28rpx;background:var(--green);color:#fff;font-size:36rpx;font-weight:700}.profile-main{flex:1;margin-left:22rpx}.profile-name{font-size:38rpx;font-weight:800}.profile-need{font-size:24rpx;color:var(--muted);margin-top:8rpx}.edit{color:var(--green);font-size:25rpx}.deal-line{display:flex;justify-content:space-between;align-items:flex-end;margin-top:34rpx}.label,.big-money{display:block}.label{color:var(--muted);font-size:22rpx}.big-money{font-size:46rpx;font-family:"DIN Alternate";font-weight:800;margin-top:8rpx}.score{text-align:center;width:80rpx}.score text{display:block}.score text:first-child{font-size:34rpx;font-weight:800;color:var(--orange)}.score text:last-child{font-size:19rpx;color:var(--muted)}.chips{display:flex;gap:12rpx;margin-top:25rpx;flex-wrap:wrap}.warm{background:#fff0e9;color:#ce643c}.status{font-size:22rpx;color:#fff;background:var(--green);border-radius:99rpx;padding:7rpx 16rpx}.customer-tags{display:flex;flex-wrap:wrap;gap:8rpx}.tag-pill{display:inline-block;background:#e7f2ed;color:var(--green);border-radius:99rpx;padding:5rpx 12rpx;font-size:20rpx;line-height:1.4}.detail-tags{margin-top:16rpx}.quick-row{display:flex;gap:14rpx;margin-top:20rpx}.quick{flex:1;background:#fff;border-radius:22rpx;font-size:24rpx;line-height:82rpx;padding:0}.quick::after{border:0}.quick text{margin-right:7rpx;color:var(--green);font-weight:700}.quick.ai{background:#eff0ff;color:#4c5192}.quick.follow{background:var(--green);color:#fff}.quick.follow text{color:#fff}.info-card{padding:10rpx 28rpx}.info-row{display:flex;justify-content:space-between;padding:23rpx 0;border-bottom:1rpx solid var(--line);font-size:26rpx}.info-row:last-child{border:0}.info-row>text:first-child{color:var(--muted)}.info-row>text:last-child{max-width:68%;text-align:right;overflow-wrap:anywhere}.green{color:var(--green)}.need-row{display:block}.need-row text{display:block}.need-row text:last-child{max-width:none;text-align:left;margin-top:12rpx;line-height:1.65}.section-head{display:flex;justify-content:space-between;align-items:center}.count{color:var(--muted);font-size:24rpx}.timeline{border-left:2rpx solid #d8dfda;margin-left:12rpx;padding-left:28rpx}.record{position:relative;margin-bottom:18rpx}.dot{position:absolute;width:15rpx;height:15rpx;border-radius:50%;background:var(--green);left:-36rpx;top:29rpx;border:7rpx solid #f6f7f2}.record-head{display:flex;justify-content:space-between;font-size:24rpx;color:var(--muted)}.record-head text:first-child{font-weight:700;color:var(--ink)}.record-content{margin-top:16rpx;line-height:1.6}.next{font-size:22rpx;color:var(--green);margin-top:15rpx}.deal-btn{margin-top:30rpx;line-height:88rpx}.delete{text-align:center;color:#b85b40;background:transparent;font-size:25rpx;margin-top:18rpx}.delete::after{border:0}.loading{text-align:center;color:var(--muted);padding-top:200rpx}.mask{position:fixed;z-index:50;left:0;right:0;top:0;bottom:0;background:rgba(7,18,14,.45);display:flex;align-items:flex-end}.deal-sheet{background:#fff;border-radius:36rpx 36rpx 0 0;width:100%;padding:34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom))}.sheet-title{font-size:37rpx;font-weight:800;margin-bottom:10rpx}.confirm{margin-top:28rpx}
.customer-summary{margin-top:24rpx;padding:24rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.summary-heading{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16rpx}.summary-title{font-size:28rpx;font-weight:700;line-height:1.4}.summary-update{margin:0;padding:0 14rpx;font-size:23rpx;line-height:64rpx;border-radius:8rpx;max-width:100%}.summary-label{font-size:25rpx;font-weight:700;line-height:1.5;margin:20rpx 0 8rpx}.summary-content{display:block;font-size:26rpx;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;color:#424d47}.summary-facts{font-size:24rpx;line-height:1.6;color:var(--muted);margin-top:16rpx;overflow-wrap:anywhere}.suggestion{border-left:4rpx solid var(--green);padding-left:16rpx}.summary-meta{font-size:22rpx;line-height:1.5;color:var(--muted);margin-top:12rpx}.summary-stale{font-size:23rpx;color:#957719;line-height:1.5;margin-top:12rpx}.summary-error{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12rpx;margin-top:16rpx;font-size:24rpx;color:#b85b40;line-height:1.5}.summary-retry{font-size:24rpx;line-height:60rpx;border-radius:8rpx;padding:0 18rpx;margin:0}.profile-main{min-width:0}.profile-name,.profile-need{overflow-wrap:anywhere}.profile-top{gap:12rpx}.edit,.big-avatar{flex-shrink:0}
.record-score{font-size:24rpx;line-height:1.6;color:var(--green);margin-top:16rpx}.record-signals{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:8rpx;font-size:22rpx;color:var(--muted)}
.summary-notice{font-size:25rpx;line-height:1.6;color:var(--green);margin-top:16rpx;overflow-wrap:anywhere}
