.member-page{text-align:center;background:linear-gradient(#edf4f0,#f6f7f2 45%)}.crown{margin:20rpx auto;width:95rpx;height:95rpx;border-radius:30rpx;background:#172c25;color:#e7bc78;line-height:95rpx;font-size:48rpx}.headline{font-size:43rpx;font-weight:800}.sub{font-size:24rpx;color:var(--muted);margin-top:10rpx}.price{font-family:"DIN Alternate";font-size:78rpx;font-weight:800;color:var(--green);margin:30rpx 0}.price text{font-size:25rpx;font-weight:500;margin:0 6rpx}.plan{text-align:left;padding:12rpx 30rpx}.plan-row{display:flex;align-items:center;padding:21rpx 0;border-bottom:1rpx solid var(--line)}.plan-row:last-child{border:0}.plan-row>text{width:50rpx;height:50rpx;border-radius:50%;background:#e2efe9;color:var(--green);line-height:50rpx;text-align:center;margin-right:20rpx;font-weight:800}.plan-row view view{font-size:28rpx;font-weight:650}.plan-row view text{display:block;color:var(--muted);font-size:22rpx;margin-top:5rpx}.agreement-row{display:flex;align-items:center;justify-content:center;margin:28rpx 0 0;color:#69736e;font-size:23rpx}.checkbox{width:34rpx;height:34rpx;border:2rpx solid #aeb8b3;border-radius:7rpx;margin-right:10rpx;line-height:34rpx;color:#fff;font-size:24rpx}.checkbox.checked{background:var(--green);border-color:var(--green)}.agreement-link{color:var(--green);margin-left:6rpx}.subscribe{margin-top:24rpx;line-height:94rpx}
.dormant-link{margin:24rpx 0;font-size:26rpx;line-height:76rpx;border-radius:8rpx}
