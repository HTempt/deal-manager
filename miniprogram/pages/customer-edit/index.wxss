.edit-page{padding-bottom:40rpx}.picker-value{display:flex;justify-content:space-between;font-size:29rpx}.picker-value text{color:#9aa19e}.datetime{display:flex;gap:20rpx}.datetime picker{flex:1;background:#f4f6f2;border-radius:16rpx;padding:18rpx 20rpx;color:#3f4844}.tip{text-align:center;color:#8a928e;font-size:23rpx;margin:24rpx}.save{margin-top:24rpx;line-height:92rpx}.field-label-row{display:flex;justify-content:space-between;align-items:center}.tags-count{font-size:22rpx;color:var(--muted)}.tag-options{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.tag-option{box-sizing:border-box;border-radius:99rpx;padding:8rpx 16rpx;font-size:22rpx;line-height:1.4;margin:0;min-width:0;max-width:100%;overflow-wrap:anywhere;background:#f1f4f1;color:#68716d}.tag-option::after{border:0}.tag-option.selected{background:var(--green);color:#fff}.custom-tag-entry{display:flex;align-items:center;gap:12rpx;margin-top:16rpx}.custom-tag-entry .input{flex:1;min-width:0}.add-tag{flex:0 0 auto;margin:0;padding:0 22rpx;line-height:72rpx;font-size:24rpx}
.score-modes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4rpx;background:#f0f3f1;padding:4rpx;border-radius:8rpx}.score-mode{width:100%;margin:0;border-radius:6rpx;background:transparent;font-size:25rpx;line-height:66rpx;padding:0 8rpx;color:var(--muted)}.score-mode::after{border:0}.score-mode.active{background:var(--green);color:#fff}.score-entry{display:flex;gap:16rpx;align-items:center;margin-top:18rpx}.score-entry input{box-sizing:border-box;width:120rpx;height:68rpx;text-align:center;border:1rpx solid var(--line);border-radius:8rpx;font-size:30rpx;font-weight:700}.score-entry text{color:var(--muted);font-size:24rpx}
